{
  "realm": "acme-bank",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Self-service banking customer" },
      { "name": "banker", "description": "Bank staff performing day-to-day operations" },
      { "name": "admin", "description": "Full administrative control, composite of banker", "composite": true, "composites": { "realm": ["banker"] } }
    ]
  },
  "clients": [
    {
      "clientId": "acme-bank-web",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [{ "type": "password", "value": "customer123", "temporary": false }],
      "realmRoles": ["customer"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Banker",
      "credentials": [{ "type": "password", "value": "banker123", "temporary": false }],
      "realmRoles": ["banker"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
